# Manga Reader - Apache Rewrite Rules
Options -Indexes
RewriteEngine On
RewriteRule ^(?:cache|lib|templates|tests|vendor)(?:/|$) - [F,L]
RewriteRule ^(?:config\.php|.*\.(?:json|lock|log|sql|db)|\..*)$ - [F,L]


# Allow direct access to existing files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Allow direct access to existing directories
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rewrite all other requests to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
